    {
      "claim": {
        "id": "cl-boarding",
        "siteId": "site-anduiza",
        "contributorId": "c-marisol",
        "text": "The Anduiza building on Grove Street took in Basque sheepherders when they came off the range. My great-grandmother cooked there. She started in 1922, a few years after she came over, and she stayed in that kitchen until the boarding side of it shut down.",
