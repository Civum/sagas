    {
      "claim": {
        "id": "cl-domingo",
        "siteId": "site-anduiza",
        "contributorId": "c-domingo",
        "text": "Our grandfather lived here. In winter they played pilota at the back. For us it was the boarding house, not a hotel.",
        "sourceLanguage": "eu",
        "sourceLanguageText": "Gure aitona hemen bizi izan zen. Neguan pilotan jokatzen zuten atzeko aldean. Guretzat gure etxea zen, ez ostatu bat.",
