# Copy this file to `.env` and fill in what your layer needs.
#
#   cp .env.example .env
#
# Every variable this project expects is listed here, grouped by who needs it.
# Nothing is hidden and nothing is fetched from a sponsor. If code you are
# writing needs a variable that is not in this file, add it here in the same
# turn, with a comment saying who needs it and where the value comes from.
# A variable that only exists in somebody's local .env is a setup failure
# waiting for the next person.
#
# `.env` is gitignored. This file is committed, which is why nothing in it is
# a real secret.
#
# Legend:
#   REQUIRED  the thing will not run without it
#   OPTIONAL  it runs without it, in a documented reduced way


# ---------------------------------------------------------------------------
# Map — experience layer
# ---------------------------------------------------------------------------
# OPTIONAL. Without it the map area renders a list of the same places instead.
# That path is not a fallback: it is how the map's information reaches somebody
# using a screen reader, so it ships either way and it has to be good.
#
# Register your own at https://account.mapbox.com/ — free, no card. Use the
# default PUBLIC token, the one starting `pk.`. Never an `sk.` token; nothing
# here needs one.
NEXT_PUBLIC_MAPBOX_TOKEN=""


# ---------------------------------------------------------------------------
# Database — experience and intelligence layers
# ---------------------------------------------------------------------------
# REQUIRED for both, once you have a schema to talk to.
#
# This is the local container from docker compose. Run `pnpm db:up` then
# `pnpm db:verify`, which prints this exact line back to you.
#
# Port 5433, not 5432, so it does not collide with a Postgres you already run.
DATABASE_URL="postgresql://sagas:sagas@localhost:5433/sagas"


# ---------------------------------------------------------------------------
# Object storage — content layer
# ---------------------------------------------------------------------------
# REQUIRED for the content layer. The other two layers can leave this block
# alone entirely.
#
# Local container again. Run `pnpm storage:up` then `pnpm storage:verify`,
# which creates the bucket and prints these values.
#
# These are development credentials for a container on your own machine. They
# are committed on purpose and they protect nothing. Never carry this pattern
# to a real bucket.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="sagas-media"
S3_ACCESS_KEY_ID="sagas"
S3_SECRET_ACCESS_KEY="sagas-dev-secret"

# MinIO addresses buckets by path. Real S3 addresses them by subdomain. This
# one line is the entire difference between local storage and a real bucket,
# which is the point of writing everything against the S3 API.
S3_FORCE_PATH_STYLE="true"
