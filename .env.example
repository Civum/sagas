# Copy to .env and fill in. That is the whole setup.
#
# There are no sponsor-provided credentials. Nothing in this repo talks to a
# service you need our permission to reach. If a task seems to require a key
# you do not have, that is a bug in the scaffold — tell us.

# Local Postgres from docker compose. Only needed once packages/db exists.
DATABASE_URL="postgresql://sagas:sagas@localhost:5433/sagas"

# Register your own free-tier token at https://account.mapbox.com/
# Free tier is far more than a semester of development needs.
NEXT_PUBLIC_MAPBOX_TOKEN=""
